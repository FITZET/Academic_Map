# The MVP runs with built-in demo data when DATABASE_URL is not configured.
DATABASE_URL="postgresql://academic_map:password@localhost:5432/academic_map?schema=public"

# Optional academic data providers
OPENALEX_API_KEY=""
SEMANTIC_SCHOLAR_API_KEY=""
ORCID_CLIENT_ID=""
ORCID_CLIENT_SECRET=""
IEEE_API_KEY=""

# Optional S3-compatible storage for interaction attachments
S3_ENDPOINT=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# Used to protect the scheduled sync endpoint in production
CRON_SECRET="change-me"
NEXT_PUBLIC_APP_NAME="Academic Atlas"
